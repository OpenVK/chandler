{
    "name": "openvk/chandler",
    "description": "Chandler is a PHP 8.2+ web framework powering OpenVK.",
    "keywords": ["framework"],
    "license": "ISC",
    "support": {
        "source": "https://github.com/OpenVK/chandler"
    },
    "repositories": [
        {
            "type": "path",
            "url": "/opt/phpstan-latte",
            "options": {
                "symlink": true
            }
        }
    ],
    "bin": [
        "bin/chandler-latte-lint"
    ],
    "scripts": {
        "fix": "php-cs-fixer fix",
        "lint": "php-cs-fixer fix --dry-run --diff --verbose",
        "analyse": "phpstan analyse --no-progress",
        "analyse:examples": "phpstan analyse --no-progress -c phpstan.examples.neon"
    },
    "require": {
        "php": "~8.2",
        "nette/utils": "^4.0",
        "nette/di": "^3.2",
        "nette/database": "^3.2",
        "symfony/mailer": "^7.3",
        "latte/latte": "^3.1",
        "firebase/php-jwt": "^7.1",
        "symfony/yaml": "^7.3",
        "wildbit/postmark-php": "^7.0",
        "tracy/tracy": "^2.11",
        "predis/predis": "^3.4"
    },
    "suggest": {
        "ext-yaml": "for faster yaml parsing"
    },
    "autoload": {
        "psr-4": {
            "Chandler\\": "chandler/"
        },
        "classmap": [
            "chandler/Bootstrap.php"
        ],
        "files": [
            "chandler/procedural/yaml.php",
            "chandler/procedural/panic.php",
            "chandler/procedural/db_busy.php",
            "chandler/procedural/mimes.php",
            "chandler/procedural/escape_url.php",
            "chandler/procedural/captcha.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Chandler\\PHPStanLatte\\": "tools/phpstan-latte/"
        }
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.90",
        "phpstan/phpstan": "^2.2",
        "efabrica/phpstan-latte": "^0.20.1"
    }
}
